# anova(m_mean)
# summary(m_mean)
# }
#confint(m_mean)
# ##--------------------------- run SD leave model -----------------------
data <- data %>% group_by(sub, patch, env) %>% summarise(sd_lt = sd(leaveT))
# set contrasts for patch and environment
data$patch <- factor(data$patch, ordered = T)
data$env <- factor(data$env, ordered = T)
contrasts(data$patch) <- contr.sum(n_patch) # repeated contrasts ('sliding differences')
contrasts(data$env) <- contr.sum(2) # same as coding block type as 0.5 or -0.5
data$sub <- factor(data$sub)
#m_sd <- afex::aov_ez("sub", "sd_lt", data, within = c("patch", "env"))
## Diagnostics - used afex::aov since can be used with performance package
#performance::check_sphericity(m_sd)
#plot(performance::check_normality(m_sd))
options(contrasts = c("contr.sum", "contr.sum"))
afex_options(type = "III")
a <- aov_ez(id = "sub",
dv = "sd_lt",
data = data,
within = c("patch","env"))
summary(a)
omega_squared(a)
pairs(emmeans(a, "patch"), reverse = T)
pairs(emmeans(a, "env"), reverse = T)
a <- aov_ez(id = "sub",
dv = "sd_lt",
data = data,
within = c("patch","env"), type = 3)
summary(a)
omega_squared(a)
tab$omega_p2_manual <- (tab$df * (tab$F - 1)) / (tab$df * (tab$F - 1) + tab$df.res + 1)
# Get the raw ANOVA table without corrections
tab <- afex::nice(a, es = "none", correction = "none", intercept = FALSE)
tab
# Columns you'll use: Effect, df, df.res, SSn, SSd, MSn (= SSn/df), MSd (= SSd/df.res), F
# Partial omega^2 from F, df1, df2
tab$omega_p2_manual <- (tab$df * (tab$F - 1)) / (tab$df * (tab$F - 1) + tab$df.res + 1)
View(tab)
tab$omega_p2_manual <- (tab$df * (tab$F - 1)) / (tab$df * (tab$F - 1) + tab$df.res + 1)
View(tab)
df1 <- tab$`num Df`
df2 <- tab$`den Df`
Fval <- tab$`F value`
omega_p2_manual <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
View(tab)
# Get the raw ANOVA table without corrections
tab <- a$anova_table
tab <- a$anova_table
df1 <- tab$`num Df`
df2 <- tab$`den Df`
Fval <- tab$`F value`
omega_p2_manual <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
Fval <- tab$`F`
omega_p2_manual <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
tab <- a$anova_table  # raw numeric table (no stars)
Fval <- tab$`F`
df1  <- tab$`num Df`
df2  <- tab$`den Df`
omega_p2 <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
cbind(effect = rownames(tab), df1, df2, Fval, omega_p2)
effectsize::omega_squared(a, partial = TRUE)  # should match
tab <- a$anova_table  # this is what effectsize uses
Fval <- tab$`F value`
df1  <- tab$`num Df`
df2  <- tab$`den Df`
omega_manual <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
omega_es <- effectsize::omega_squared(a, partial = TRUE)
Fval <- tab$`F`
df1  <- tab$`num Df`
df2  <- tab$`den Df`
omega_manual <- (df1 * (Fval - 1)) / (df1 * (Fval - 1) + df2 + 1)
omega_es <- effectsize::omega_squared(a, partial = TRUE)
cbind(tab, omega_manual, omega_es = omega_es$Omega2_partial)
m_afex <- aov_car(sd-Lt ~ patch*env + Error(sub/(patch*env)), data = data)
m_afex <- aov_car(sd_lt ~ patch*env + Error(sub/(patch*env)), data = data)
omega_squared(m_afex, partial = TRUE)
tab <- a$anova_table  # raw numeric table (no stars)
a <- aov_ez(id = "sub",
dv = "sd_lt",
data = data,
within = c("patch","env"), type = 3)
omega_squared(a)
View(a)
tab <- a$anova_table  # raw numeric table (no stars)
View(tab)
summary(a)
View(a)
etq_squared(a,partial = TRUE)
eta_squared(a,partial = TRUE)
eta_squared(a)
