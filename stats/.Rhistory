anova(m_mean)
summary(m_mean)
} else if (study == 'contrerashuerta'){
# CONTRERAS-HUERTA
m_mean <- lmerTest::lmer(mean_lt ~ patch*env +
(patch*env|sub), data = data,
control = lmerControl(optimizer = c('bobyqa'), optCtrl=list(maxfun=20000)))
anova(m_mean)
